{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["automated", "renovate"],
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Go versions",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/", "/^Dockerfile$/"],
      "matchStrings": [
        "GO_VERSION: ['\\\"]?(?<currentValue>.*?)['\\\"]?\\n",
        "ARG GO_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "packageNameTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "matchManagers": ["gomod", "custom.regex"],
      "groupName": "golang versions"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
